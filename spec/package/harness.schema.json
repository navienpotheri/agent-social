{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:asp:package:v0.1:harness",
  "title": "Runtime-neutral agent harness",
  "description": "harness/harness.json inside an agent package: the agent's instructions, skills, subagents, commands, hooks, tools and permissions, captured from one runtime and materialized into another. Paths are relative to the harness/ directory. Secret values never appear: they are {\"$secret\": NAME} placeholders resolved from the environment at run time.",
  "type": "object",
  "required": ["format", "instructions", "skills", "subagents", "commands", "hooks", "mcp_servers", "permissions", "env"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "asp.harness/v0.1" },
    "instructions": {
      "description": "Standing instructions, in load order.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "scope", "path"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "description": "Original file name, e.g. CLAUDE.md, AGENTS.md, rules/testing.md" },
          "scope": { "enum": ["project", "local", "user", "rules"] },
          "path": { "type": "string" },
          "applies_to": {
            "description": "Path globs the instruction is limited to (Claude Code rules frontmatter).",
            "type": "array", "items": { "type": "string" }
          }
        }
      }
    },
    "skills": { "type": "array", "items": { "$ref": "#/$defs/component" } },
    "subagents": { "type": "array", "items": { "$ref": "#/$defs/component" } },
    "commands": { "type": "array", "items": { "$ref": "#/$defs/component" } },
    "hooks": {
      "description": "Lifecycle hooks, in Claude Code's hooks shape: { EventName: [ { matcher?, hooks: [ { type, command, ... } ] } ] }.",
      "type": "object"
    },
    "mcp_servers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "command": { "type": "string" },
          "args": { "type": "array", "items": { "type": "string" } },
          "url": { "type": "string" },
          "env": { "$ref": "#/$defs/env" },
          "headers": { "$ref": "#/$defs/env" }
        }
      }
    },
    "permissions": {
      "type": "object",
      "required": ["allow", "deny", "ask"],
      "additionalProperties": false,
      "properties": {
        "allow": { "type": "array", "items": { "type": "string" } },
        "deny": { "type": "array", "items": { "type": "string" } },
        "ask": { "type": "array", "items": { "type": "string" } },
        "default_mode": { "type": "string" }
      }
    },
    "env": { "$ref": "#/$defs/env" },
    "model": { "type": "string" },
    "secrets": {
      "description": "Names of every secret the harness needs at run time.",
      "type": "array", "items": { "type": "string" }, "uniqueItems": true
    },
    "runtime_specific": {
      "description": "Components with no neutral form yet, keyed by runtime name.",
      "type": "object"
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "required": ["name", "path"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "path": { "type": "string" },
        "scope": { "enum": ["project", "user"] }
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["$secret"],
            "additionalProperties": false,
            "properties": { "$secret": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" } }
          }
        ]
      }
    }
  }
}
