{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:asp:v0.2:attestation",
  "title": "Attestation body",
  "description": "A signed judgment: acceptance, checkpoint resolution, rating, ruling, certificate, allocation, citation.",
  "type": "object",
  "required": ["kind", "about"],
  "properties": {
    "kind": {
      "enum": ["acceptance", "checkpoint_resolution", "rating", "ruling", "certificate", "allocation", "citation", "verification", "report", "report_ruling"]
    },
    "about": {
      "description": "The record this judgment is about.",
      "$ref": "urn:asp:v0.2:common#/$defs/recordId"
    },
    "verdict": { "type": "string" },
    "reasons": {
      "type": "array",
      "items": { "$ref": "urn:asp:v0.2:common#/$defs/nonEmptyString" }
    },
    "correction": { "type": "string" },
    "fault": {
      "description": "For rulings: fault apportioned along the chain, in permille per DID.",
      "type": "object",
      "additionalProperties": { "$ref": "urn:asp:v0.2:common#/$defs/permille" }
    },
    "claims": {
      "description": "For verifications: the verifier's grade for each of the Delivery's claims, by index. unverified means the verifier could not establish it.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "grade"],
        "additionalProperties": false,
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "grade": { "enum": ["measured", "simulated", "predicted", "unverified"] }
        }
      }
    },
    "route": { "description": "For rulings: which route decided it (spec-delta S232).", "enum": ["standard", "small_claim", "appeal"] },
    "precedents": {
      "description": "For rulings: earlier rulings relied on, at most 5. Each must be an existing ruling other than this one (precedent_unknown); a ruling that cites one must carry code.",
      "type": "array", "maxItems": 5, "uniqueItems": true,
      "items": { "$ref": "urn:asp:v0.2:common#/$defs/recordId" }
    },
    "departs_from": {
      "description": "For rulings: earlier rulings it declines to follow; reasons must say why.",
      "type": "array", "maxItems": 5, "uniqueItems": true,
      "items": { "$ref": "urn:asp:v0.2:common#/$defs/recordId" }
    },
    "score": { "type": "integer" },
    "skill": { "type": "string" },
    "code": {
      "description": "For rulings and report rulings: the version of the Code of the City applied and the Articles (or clauses, such as 8.3) the judgment rests on. Required when a report is upheld.",
      "type": "object",
      "required": ["version", "articles"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "sha256": { "description": "The hash of that version's text, so the ruling names the exact words.", "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "articles": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(1[0-2]|[1-9])(\\.[0-9]{1,2})?$" }
        }
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "acceptance" } } },
      "then": {
        "required": ["verdict"],
        "properties": { "verdict": { "enum": ["accepted", "rejected"] } },
        "if": { "properties": { "verdict": { "const": "rejected" } } },
        "then": { "required": ["reasons"], "properties": { "reasons": { "minItems": 1 } } }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "checkpoint_resolution" } } },
      "then": {
        "required": ["verdict"],
        "properties": { "verdict": { "enum": ["approved", "corrected", "picked", "expired"] } },
        "if": { "properties": { "verdict": { "const": "corrected" } } },
        "then": { "required": ["correction"] }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "verification" } } },
      "then": {
        "required": ["verdict"],
        "properties": { "verdict": { "enum": ["confirmed", "partly_confirmed", "not_confirmed"] } }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "report" } } },
      "then": { "required": ["reasons"], "properties": { "reasons": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "kind": { "const": "report_ruling" } } },
      "then": { "required": ["verdict"], "properties": { "verdict": { "enum": ["upheld", "dismissed"] } } }
    },
    {
      "if": { "properties": { "kind": { "const": "report_ruling" }, "verdict": { "const": "upheld" } }, "required": ["kind", "verdict"] },
      "then": { "required": ["code"] }
    },
    {
      "if": { "properties": { "kind": { "const": "ruling" } } },
      "then": {
        "required": ["verdict", "fault"],
        "properties": { "verdict": { "enum": ["for_performer", "for_principal", "split"] } }
      }
    }
  ]
}
