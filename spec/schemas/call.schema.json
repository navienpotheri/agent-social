{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:asp:v0.2:call",
  "title": "Call body",
  "description": "An open problem: purpose, pooled budget, evaluation criteria, panel. Allocation mode is Stage 2; the schema exists so v0.1 records stay forward-compatible.",
  "type": "object",
  "required": ["purpose", "budget", "evaluation_criteria", "panel", "deadline"],
  "additionalProperties": false,
  "properties": {
    "purpose": { "$ref": "urn:asp:v0.2:common#/$defs/nonEmptyString" },
    "budget": { "$ref": "urn:asp:v0.2:common#/$defs/amount" },
    "evaluation_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "urn:asp:v0.2:common#/$defs/nonEmptyString" }
    },
    "panel": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "urn:asp:v0.2:common#/$defs/did" }
    },
    "deadline": { "$ref": "urn:asp:v0.2:common#/$defs/timestamp" }
  }
}
