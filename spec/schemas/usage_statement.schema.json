{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:asp:v0.2:usage_statement",
  "title": "Usage statement body",
  "description": "A closed month for an organisation or a fleet (register row DK1379; spec-delta S1414): the usage counted from the log, the plan that priced it, the lines, the tax lines and the total in minor units of the plan's currency. The operator signs it; the log recomputes the pricing from the signed plan and refuses a statement whose lines, subtotal, tax or total do not follow from the usage, and a second statement for the same holder, fleet and month. Anyone can recompute the usage from the log's records (`usage_hash` is the hash of the usage as counted). `credits_applied` settles part or all of the total with the holder's purchased credits at the plan's credit value, which the log draws from its lots and pays to the Treasury. An invoice by contract first; the payment of money is another lane's part. Chain: none (prev is null).",
  "type": "object",
  "required": [
    "holder",
    "month",
    "plan",
    "usage",
    "lines",
    "subtotal",
    "tax",
    "total",
    "currency"
  ],
  "additionalProperties": false,
  "properties": {
    "holder": {
      "$ref": "urn:asp:v0.2:common#/$defs/did"
    },
    "fleet": {
      "$ref": "urn:asp:v0.2:common#/$defs/did"
    },
    "month": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
    },
    "plan": {
      "type": "string"
    },
    "usage": {
      "type": "object",
      "required": [
        "active_agents",
        "writes",
        "tokens",
        "storage_bytes"
      ],
      "additionalProperties": false,
      "properties": {
        "active_agents": {
          "type": "integer",
          "minimum": 0
        },
        "writes": {
          "type": "integer",
          "minimum": 0
        },
        "tokens": {
          "type": "integer",
          "minimum": 0
        },
        "storage_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "reads": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "usage_hash": {
      "$ref": "urn:asp:v0.2:common#/$defs/sha256"
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "item",
          "quantity",
          "unit_price",
          "amount"
        ],
        "additionalProperties": false,
        "properties": {
          "item": {
            "$ref": "urn:asp:v0.2:common#/$defs/nonEmptyString"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "unit_price": {
            "type": "integer",
            "minimum": 1
          },
          "amount": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "subtotal": {
      "type": "integer",
      "minimum": 0
    },
    "tax": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "rate_bp",
          "amount"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "$ref": "urn:asp:v0.2:common#/$defs/nonEmptyString"
          },
          "rate_bp": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "amount": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "credits_applied": {
      "type": "integer",
      "minimum": 1
    },
    "contract": {
      "description": "The enterprise contract this invoice is under.",
      "$ref": "urn:asp:v0.2:common#/$defs/nonEmptyString"
    }
  }
}
