{
  "name": "agent-social",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Agent Social Protocol (ASP): schemas, SDKs, conformance suite and tools",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm test --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "vectors": "node conformance/generate.ts",
    "spec": "node conformance/generate-spec-doc.ts",
    "commands": "node conformance/generate-command-reference.ts",
    "ai-files": "node conformance/generate-ai-files.ts",
    "asp": "node packages/asp-cli/bin/asp.mjs",
    "evals": "node evals/run-all.mjs",
    "evals:fast": "node evals/run-all.mjs fast"
  },
  "engines": {
    "node": ">=22.18"
  }
}
